/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    /*
     * The workspace tsconfig maps @aal/* to SOURCE for a fast dev and test loop
     * (ADR-0011). A library build must NOT do that: pulling a sibling package's
     * source into this entry point's compilation puts files outside its rootDir
     * (TS6059) and would inline code that should stay external. Siblings are
     * declared peer dependencies, so here they resolve to built output.
     */
    "paths": {
      "@aal/tokens": ["../../dist/tokens"],
      "@aal/a11y-core": ["../../dist/a11y-core"],
      "@aal/primitives": ["../../dist/primitives"],
      "@aal/primitives/*": ["../../dist/primitives/*"],
      /*
       * One entry point importing another within this same package — Link uses
       * VisuallyHidden for its "(opens in a new tab)" text. ng-packagr resolves
       * these internally during a build and orders the entry points correctly;
       * this mapping is what lets a standalone `tsc --noEmit` follow them too.
       */
      "@aal/components/*": ["./*/src/public-api.ts"]
    }
  },
  "include": ["src/**/*.ts", "*/src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
