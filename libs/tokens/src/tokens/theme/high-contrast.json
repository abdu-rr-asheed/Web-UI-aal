{
  "$description": "Tier 2 semantic tokens — explicit high-contrast theme, selected by the user or by prefers-contrast: more. Targets 7:1 (AAA 1.4.6) where achievable rather than the AA 4.5:1 floor. Distinct from forced-colors mode, which is handled in CSS with system colour keywords rather than tokens (AR-19).",
  "color": {
    "$type": "color",

    "surface": {
      "default": { "$value": "{palette.neutral.1000}" },
      "raised":  { "$value": "{palette.neutral.1000}" },
      "sunken":  { "$value": "{palette.neutral.1000}" },
      "overlay": { "$value": "{palette.neutral.1000}" },
      "scrim":   { "$value": "#000000e6" }
    },

    "text": {
      "default":     { "$value": "{palette.neutral.0}" },
      "muted":       { "$value": "{palette.neutral.0}", "$description": "No muted tier at high contrast. De-emphasis by colour is exactly what this theme's users cannot perceive; hierarchy is carried by size and weight instead." },
      "placeholder": { "$value": "{palette.neutral.0}" },
      "disabled":    { "$value": "{palette.neutral.300}" },
      "on-action":   { "$value": "{palette.neutral.1000}" },
      "on-danger":   { "$value": "{palette.neutral.1000}" },
      "link":        { "$value": "{palette.blue.200}" }
    },

    "action": {
      "bg":          { "$value": "{palette.neutral.0}" },
      "bg-hover":    { "$value": "{palette.blue.100}" },
      "bg-active":   { "$value": "{palette.blue.200}" },
      "bg-disabled": { "$value": "{palette.neutral.1000}" },
      "border":      { "$value": "{palette.neutral.0}" }
    },

    "danger": {
      "bg":      { "$value": "{palette.red.300}" },
      "text":    { "$value": "{palette.red.300}" },
      "border":  { "$value": "{palette.red.300}" },
      "surface": { "$value": "{palette.neutral.1000}" }
    },

    "success": {
      "text":    { "$value": "{palette.green.300}" },
      "border":  { "$value": "{palette.green.300}" },
      "surface": { "$value": "{palette.neutral.1000}" }
    },

    "warning": {
      "text":    { "$value": "{palette.amber.300}" },
      "border":  { "$value": "{palette.amber.300}" },
      "surface": { "$value": "{palette.neutral.1000}" }
    },

    "border": {
      "default": { "$value": "{palette.neutral.0}" },
      "strong":  { "$value": "{palette.neutral.0}" },
      "subtle":  { "$value": "{palette.neutral.400}" }
    },

    "field": {
      "bg":             { "$value": "{palette.neutral.1000}" },
      "bg-disabled":    { "$value": "{palette.neutral.1000}" },
      "border":         { "$value": "{palette.neutral.0}" },
      "border-hover":   { "$value": "{palette.blue.200}" },
      "border-invalid": { "$value": "{palette.red.300}" }
    },

    "selected": {
      "border": { "$value": "{palette.neutral.0}", "$description": "The ACTUAL selection indicator. Must meet 3:1 against the page surface (SC 1.4.11) because it is what makes the state perceivable. The bg tint below only reinforces it." },
      "bg":   { "$value": "{palette.neutral.0}" },
      "text": { "$value": "{palette.neutral.1000}" }
    },

    "focus": {
      "outer": { "$value": "{palette.yellow.hc}", "$description": "Yellow on black is the maximum-luminance-separation pairing and the convention high-contrast users expect." },
      "inner": { "$value": "{palette.neutral.1000}" }
    }
  }
}
