{
  "name": "aal-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build tokens && ng build a11y-core && ng build primitives && ng build components",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint . && npm run lint:styles",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"libs/**/*.{css,scss}\" \"apps/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node tools/typecheck.mjs",
    "tokens:build": "node libs/tokens/build-tokens.mjs",
    "tokens:validate": "node libs/tokens/build-tokens.mjs && node tools/contrast-validator/index.mjs --themes light,dark,high-contrast",
    "test:tools": "vitest run --config vitest.tools.config.mjs",
    "start:docs": "ng serve docs --port 4200",
    "e2e:a11y": "playwright test --project=a11y-chromium --project=a11y-firefox --project=a11y-webkit",
    "e2e:keyboard": "playwright test --project=keyboard",
    "e2e:forced-colors": "playwright test --project=forced-colors",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cdk": "^22.1.3",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.5",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.6.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "style-dictionary": "^5.5.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  },
  "description": "Angular Aria Library — accessibility-first Angular component library (MSc research, K2635673)",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
